# ─────────────────────────────────────────────────────────────────────────────
# Mithila Jodi — Environment Variables
# Copy to .env.local (never commit .env.local)
# ─────────────────────────────────────────────────────────────────────────────

# Site configuration — change per environment; never hardcode in code
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Mithila Jodi"

# Supabase — development project (ap-south-1)
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_dev_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key_here   # SERVER ONLY — never expose to client

# ── OTP / Authentication ─────────────────────────────────────────────────────
# DEV/TESTING fixed OTP mode.
#
# When DEV_OTP_ENABLED=true, no SMS is sent and the fixed code in DEV_OTP
# authenticates ANY registration or login (real accounts are still created).
# When false, the provider named by OTP_PROVIDER is used instead.
#
# Defaults to false on purpose: this must never be the value someone copies into
# a deployed environment. It is additionally hard-gated in code — see
# isDevOtpEnabled() in src/lib/services/otp/OtpService.ts — so the fixed code
# can never authenticate anyone when NODE_ENV=production, regardless of how this
# variable is set.
DEV_OTP_ENABLED=false
DEV_OTP=010794
# OTP provider used when DEV_OTP_ENABLED=false: "dev" (console log) or "production" (real SMS)
OTP_PROVIDER=dev
# OTP_SMS_API_KEY=           # only needed when OTP_PROVIDER=production

# ── Membership / Payments ────────────────────────────────────────────────────
# Membership gating (currently OFF - the platform is free for all members).
# interests, messaging, biodata, etc. are free for everyone. Razorpay stays
# wired up but blocks nothing. Set to false to re-enable paid gating (no code
# changes needed). Keep true during the current free-testing launch.
# Mithila Jodi is free for all members by default (no env var needed).
# Set PAID_MEMBERSHIPS_ENABLED=true only to bring paid plans back.
# PAID_MEMBERSHIPS_ENABLED=false

# Razorpay — Get from Razorpay Dashboard → Settings → API Keys
# Switch TEST → LIVE by changing ONLY these three values to rzp_live_* keys.
# KEY_ID is returned to the browser by the orders API (public by design);
# KEY_SECRET and WEBHOOK_SECRET are server-only and must never reach the client.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# DigiLocker — DEFERRED; keep empty until activated
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=

# Storage — watermarking
WATERMARK_TEXT="Mithila Jodi"                        # branding text on watermarked photos

# DPDP / Privacy
PRIVACY_POLICY_VERSION=1.0
TERMS_VERSION=1.0
