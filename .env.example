# ─────────────────────────────────────────────────────────────────────────────
# Mithila Jodi — Environment Variables
# Copy to .env.local (never commit .env.local)
# ─────────────────────────────────────────────────────────────────────────────

# Site configuration — change per environment; never hardcode in code
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Mithila Jodi"

# Supabase — development project (ap-south-1)
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_dev_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key_here   # SERVER ONLY — never expose to client

# ── OTP / Authentication ─────────────────────────────────────────────────────
# DEV/TESTING fixed OTP mode. When DEV_OTP_ENABLED=true, no SMS is sent and the
# fixed code in DEV_OTP authenticates any registration/login (real Supabase
# accounts are still created). Set DEV_OTP_ENABLED=false before real launch —
# then the fixed code STOPS working and the real provider is used.
DEV_OTP_ENABLED=true
DEV_OTP=010794
# OTP provider used when DEV_OTP_ENABLED=false: "dev" (console log) or "production" (real SMS)
OTP_PROVIDER=dev
# OTP_SMS_API_KEY=           # only needed when OTP_PROVIDER=production

# ── Membership / Payments ────────────────────────────────────────────────────
# FREE testing mode. When true, ALL membership/payment gates are bypassed —
# interests, messaging, biodata, etc. are free for everyone. Razorpay stays
# wired up but blocks nothing. Set to false to re-enable paid gating (no code
# changes needed). Keep true during the current free-testing launch.
FREE_ACCESS_MODE=true

# Razorpay — use TEST keys during development
# Get from Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id    # safe to expose (public test key)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# DigiLocker — DEFERRED; keep empty until activated
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=

# Storage — watermarking
WATERMARK_TEXT="Mithila Jodi"                        # branding text on watermarked photos

# DPDP / Privacy
PRIVACY_POLICY_VERSION=1.0
TERMS_VERSION=1.0
