# Copy this to .env.local (never commit .env.local)
# See root .env.example for full documentation

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Mithila Jodi"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_dev_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key_here
# DEV/TESTING OTP — set DEV_OTP_ENABLED=false before real launch to disable the fixed code
DEV_OTP_ENABLED=true
DEV_OTP=0794
OTP_PROVIDER=dev

# ── MSG91 OTP Widget ─────────────────────────────────────────────────────────
# When BOTH public values below are set, login/register use the MSG91 widget
# (headless) for OTP send + verify. When unset, the server-generated OTP flow
# above is used (local dev / fallback).
# Public — required client-side by the MSG91 widget (safe to expose in browser):
NEXT_PUBLIC_MSG91_WIDGET_ID=your_msg91_widget_id
NEXT_PUBLIC_MSG91_TOKEN_AUTH=your_msg91_token_auth
# SECRET — server-only. NEVER expose to the browser or commit a real value.
# Used only by /api/auth/otp/msg91 to verify the access token with MSG91.
MSG91_AUTHKEY=your_msg91_authkey_server_secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
WATERMARK_TEXT="Mithila Jodi"
PRIVACY_POLICY_VERSION=1.0
TERMS_VERSION=1.0
