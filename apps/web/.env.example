# Copy this to .env.local (never commit .env.local)
# See root .env.example for full documentation

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Mithila Jodi"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_dev_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key_here
# DEV/TESTING OTP. When true, the fixed DEV_OTP code below authenticates ANY
# login or registration. Defaults to false so this is never the value copied into
# a deployed environment; it is additionally hard-gated in code so it cannot work
# at all when NODE_ENV=production. See isDevOtpEnabled() in
# src/lib/services/otp/OtpService.ts.
DEV_OTP_ENABLED=false
DEV_OTP=0794
OTP_PROVIDER=dev

# ── MSG91 OTP Widget ─────────────────────────────────────────────────────────
# Set to true (in production/Vercel) to use the MSG91 widget for OTP send+verify.
# Leave false/unset for local dev to use the server-generated OTP + DEV_OTP above.
NEXT_PUBLIC_MSG91_ENABLED=false
# Public widget values are baked into the code as defaults (they are delivered to
# every browser, so they are not secrets). Only override here if MSG91 regenerates
# the widget:
# NEXT_PUBLIC_MSG91_WIDGET_ID=
# NEXT_PUBLIC_MSG91_TOKEN_AUTH=
# SECRET — server-only. Set this in Vercel; NEVER commit a real value or expose
# it to the browser. Used only by /api/auth/otp/msg91 to verify the access token.
MSG91_AUTHKEY=your_msg91_authkey_server_secret
# ── Payments ─────────────────────────────────────────────────────────────────
# Mithila Jodi is free for all members, so NO payment variables are required and
# none should be set in a deployed environment. The payment-execution endpoints
# were removed; only the PaymentGateway seam in src/lib/services/payment/ remains.
# If paid memberships are ever restored, re-add RAZORPAY_KEY_ID /
# RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET here at that point.
WATERMARK_TEXT="Mithila Jodi"
PRIVACY_POLICY_VERSION=1.0
TERMS_VERSION=1.0
